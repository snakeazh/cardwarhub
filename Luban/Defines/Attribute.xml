        <var name="Soldier" alias="英灵属性" />
        <var name="Damage" alias="伤害属性" />
        <var name="Monster" alias="怪物属性" />
        <var name="Buff" alias="效果属性" />
        <var name="Add" alias="加成属性" />
	</enum>

     <!-- 数值显示类型 -->
    <enum name="ValueDisplayType">
        <var name="OriginalValue" alias="原始值显示" />
        <var name="RoundUp" alias="向上取整" />
        <var name="RoundOff" alias="四舍五入" />
        <var name="RoundDown" alias="向下取整" />
        <var name="KeepDecimal2" alias="保留2位小数" />
	</enum>
    
    <!-- 属性配置 -->
    <bean name="AttributeConfig" >
        <var name="AttributeType" type="AttributeType" />
        <var name="Name" type="string" />
         <var name="Icon" type="string" />
        <var name="ValueLimit" type="ValueLimitStruct" />
        <var name="Algorithm" type="string" />
        <var name="Category" type="AttributeCategoryType" />
        <var name="DisplayType" type="ValueDisplayType" />
        <var name="AdditionAttributes" type="(list#sep=|),AttributeStruct" />
	</bean>
	<table name="TbAttributeConfig" value="AttributeConfig" input="GamePlay/AttributeConfig.xlsx"/>

    <!-- 主属性配置 -->
    <bean name="MainAttributeConfig" >
        <var name="MainAttributeType" type="MainAttributeType" />
        <var name="Icon" type="string" />
        <var name="Name" type="string" />
        <var name="ValueLimit" type="ValueLimitStruct" />
        <var name="Algorithm" type="string" />
        <var name="Category" type="AttributeCategoryType" />
        <var name="DisplayType" type="ValueDisplayType" />
        <var name="ConvertToBaseAttributes" type="(list#sep=|),AttributeStruct" />
	</bean>
	<table name="TbMainAttributeConfig" value="MainAttributeConfig" input="GamePlay/MainAttributeConfig.xlsx"/>

    <!-- 属性结构 -->
    <bean name="AttributeStruct" sep=":" >
        <var name="Type" type="AttributeType" /> 
        <var name="Value" type="float" />
        <var name="ValueType" type="ValueType" />
        <var name="EffectParam" type="float" /> <!-- 生效参数 -->
        <var name="ProbabilityTrigger" type="float" /> <!-- 概率触发：0，必触发 -->
    </bean>


    <!-- 主属性结构 -->
    <bean name="MainAttributeStruct" sep=":" >
        <var name="Type" type="MainAttributeType" />
        <var name="Value" type="float" />
        <var name="ValueType" type="ValueType" />
        <var name="EffectParam" type="float" /> <!-- 生效参数 -->
    </bean>


    <!-- 数值上限结构 -->
    <bean name="ValueLimitStruct" sep="|" >
        <var name="Minimum" type="float" />
        <var name="Maximum" type="float" />
    </bean>



</module>
