<module name="">

    <!-- 条件类型 -->
    <enum name="SpecialsType">
        <var name="GoalAttribute" alias="属性判断" />
        <var name="WarriorNum" alias="战士数量" />
        <var name="ArcherNum" alias="射手数量" />
        <var name="MageNum" alias="法师数量" />
        <var name="AssassinNum" alias="刺客数量" />
        <var name="AssistantNum" alias="辅助数量" />
        <var name="PowerHero" alias="力量系英灵" />
        <var name="IntHero" alias="智力系英灵" />
        <var name="AgHero" alias="敏捷系英灵" />
        <var name="HeroNum" alias="英灵数量" />
        <var name="AddDamage" alias="附加伤害" />
        <var name="CumulativeJudgment" alias="累计判断" />
        <var name="HighLevelArcherNum" alias="最高级射手数量" />
        <var name="HighLevelWarriorNum" alias="最高级战士数量" />
        <var name="HighLevelMageNum" alias="最高级法师数量" />
        <var name="HighLevelAssassinNum" alias="最高级刺客数量" />
        <var name="HighLevelAssistantNum" alias="最高级辅助数量" />
        <var name="MainStage" alias="主线挑战" />
        <var name="DifferentProNum" alias="不同职业数量" />
        <var name="LiveMageNum" alias="存活法师数量" />
        <var name="LiveWarriorNum" alias="存活战士数量" />
        <var name="IsAssistant" alias="辅助职业判断" />
        <var name="BuyEffectsNumInBattle" alias="购买强化效果数量" />
        <var name="IsNormalMonster" alias="普通敌人判断" />
        <var name="IsBossMonster" alias="精英或首领敌人判断" />
        <var name="IsRemoteMonster" alias="远程怪物判断" />
        <var name="IsFlyingMonster" alias="飞行怪物判断" />
        <var name="IsArcher" alias="射手职业判断" />
        <var name="IsWarrior" alias="战士职业判断" />
        <var name="IsMage" alias="法师职业判断" />
        <var name="IsAssassin" alias="刺客职业判断" />


	</enum>


    <!-- 比较方式类型 -->
    <enum name="ComparisonsType">
        <var name="GreaterThanOrEqualTo" alias="大于等于" />
        <var name="GreaterThan" alias="大于" />
        <var name="LessThan" alias="小于" />
        <var name="LessThanOrEqualTo" alias="小于等于" />
        <var name="EqualTo" alias="等于" />        
        <var name="Percent" alias="百分比" />
        <var name="Yes" alias="是" />
        <var name="No" alias="否" />
	</enum>


    <!-- 比较值类型 -->
    <enum name="ComparisonValuesType">
        <var name="Percent" alias="百分比" />
        <var name="Number" alias="数值" />
	</enum>


    <!-- 条件配置 -->
    <bean name="ConditionGroupConfig" >
        <var name="Id" type="int" />
        <var name="SpecialType" type="SpecialsType" />
        <var name="Attribute" type="AttributeType" />
        <var name="ComparisonType" type="ComparisonsType" />
        <var name="ComparisonValue" type="float" />
        <var name="ComparisonValueType" type="ComparisonValuesType" />

	</bean>
	<table name="TbConditionGroupConfig" value="ConditionGroupConfig" input="GamePlay/ConditionGroupConfig.xlsx"/>



    
</module>
